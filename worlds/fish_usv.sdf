<?xml version="1.0"?>
<sdf version="1.9">
  <!-- PX4 spawns fish_usv_0 into this world at the pose set by its airframe. -->
  <world name="fish_usv">
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <!-- Freshwater below z=0 and air above it. The visual surface has no
         collision, allowing the vessel to float through the waterline. -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change><above_depth>0</above_depth><density>1.225</density></density_change>
      </graded_buoyancy>
      <enable>fish_usv_0</enable>
    </plugin>
    <scene>
      <grid>false</grid>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.5 0.7 0.9 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.2 0.2 -1</direction>
    </light>
    <model name="water_surface">
      <static>true</static>
      <link name="surface">
        <visual name="surface">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <transparency>0.75</transparency>
          <material><ambient>0.05 0.3 0.5 1</ambient><diffuse>0.05 0.3 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="seabed">
      <static>true</static>
      <pose>0 0 -5 0 0 0</pose>
      <link name="bed">
        <collision name="bed_collision"><geometry><box><size>100 100 0.2</size></box></geometry></collision>
        <visual name="bed_visual">
          <geometry><box><size>100 100 0.2</size></box></geometry>
          <material><ambient>0.45 0.4 0.25 1</ambient><diffuse>0.45 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>51.971659</latitude_deg>
      <longitude_deg>5.384925</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
