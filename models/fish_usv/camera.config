<?xml version="1.0"?>
<!-- Use a main window: gz-gui 8.4 ImageDisplay can crash in standalone mode. -->
<gui>
  <window>
    <width>960</width>
    <height>600</height>
  </window>
  <plugin filename="ImageDisplay">
    <gz-gui>
      <title>Fish USV underwater camera</title>
      <property type="string" key="state">docked</property>
    </gz-gui>
    <topic>/world/fish_usv/model/fish_usv_0/link/base_link/sensor/fish_camera/image</topic>
    <topic_picker>true</topic_picker>
  </plugin>
  <plugin filename="ImageDisplay">
    <gz-gui>
      <title>Fish USV forward camera</title>
      <property type="string" key="state">docked</property>
    </gz-gui>
    <topic>/world/fish_usv/model/fish_usv_0/link/base_link/sensor/forward_camera/image</topic>
    <topic_picker>true</topic_picker>
  </plugin>
</gui>
